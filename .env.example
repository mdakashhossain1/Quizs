APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Kolkata
BUSINESS_TIMEZONE=Asia/Kolkata
# Only needed when the domain's document root sits one level above Laravel's
# public/ folder (common on shared hosting without a document-root setting) —
# set it to APP_URL + /public so asset() finds files that physically live in
# public/ (logos, build assets). Leave unset when the document root IS
# public/, which is when APP_URL already resolves everything correctly.
# ASSET_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Shared secret required as ?key= on GET /api/cron/run-queue, the webhook
# an HTTP-based cron service (e.g. cron-job.org) hits to drain the mail queue.
CRON_SECRET=
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

FIREBASE_API_KEY=

# Firebase Cloud Messaging (push notifications). FCM_CREDENTIALS_JSON is the
# whole downloaded service-account JSON file as a single-line, single-quoted
# value — preferred on shared hosting, since it doesn't depend on a private
# storage path surviving a deploy. FCM_CREDENTIALS_PATH (absolute path to
# that same JSON on disk) is used only as a fallback when the inline value
# isn't set.
FCM_PROJECT_ID=
FCM_CREDENTIALS_JSON=
FCM_CREDENTIALS_PATH=

VITE_APP_NAME="${APP_NAME}"

OFFERWALL_ENABLED=false
OFFERWALL_SDK_KEY=
OFFERWALL_PLACEMENT="#WebOfferwall"
OFFERWALL_CALLBACK_SECRET=
OFFERWALL_CALLBACK_MODE=hmac_sha256
